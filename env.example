# Copie para .env.local e preencha. O .env.local nunca vai para o Git.

# URL pública do site — usada nos retornos do Mercado Pago
APP_URL=http://localhost:3000

# Neon: postgresql://usuario:senha@host.neon.tech/casamento?sslmode=require
DATABASE_URL=

# Mercado Pago — credenciais de produção
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Assinatura do webhook. Sem ela, qualquer um pode marcar um pedido como pago.
MP_WEBHOOK_SECRET=

# Bearer que o cron de conciliação envia. Gere uma string aleatória longa.
CRON_SECRET=
