# Copie para .env.local e preencha. O .env.local nunca vai para o Git.

# URL pública do site — usada nos retornos do Mercado Pago
APP_URL=http://localhost:3000

# postgresql://casamento:<senha>@pg-casamento.postgres.database.azure.com/casamento?sslmode=verify-full
DATABASE_URL=

# Mercado Pago — comece pelas credenciais de teste (TEST-...)
MP_ACCESS_TOKEN=

# Chave pública do Card Payment Brick.
#
# Sem prefixo NEXT_PUBLIC_ de propósito: esse prefixo é resolvido no build,
# e o build acontece no GitHub Actions, antes de o Container Apps injetar
# qualquer coisa. A chave é lida no servidor e passada como prop ao Brick.
MP_PUBLIC_KEY=

# Assinatura do webhook. Sem ela, qualquer um que descubra a URL marca um
# pedido como pago. Aparece uma única vez ao salvar as notificações.
MP_WEBHOOK_SECRET=

# Bearer que o cron de conciliação envia. Gere uma string aleatória longa.
CRON_SECRET=
